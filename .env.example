# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=gsk_your-groq-key-here
LLM_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store (Qdrant) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medical_docs
QDRANT_API_KEY=
# Embedding model (requires OPENAI_API_KEY)
EMBEDDING_MODEL=text-embedding-3-small

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Cổng ở đây phải khớp với server.port trong frontend/vite.config.ts (đang ghim
# 5180 kèm strictPort). Đổi cổng thì nhớ đổi cả hai chỗ, nếu không trình duyệt
# sẽ chặn request từ frontend vì CORS.
CORS_ORIGINS=http://localhost:5180

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=ai20k_phmNVXYWaPJ-2JI0txxVlg5uClpM3uKl
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# VITE_API_URL=
# Để trống khi chạy dev: proxy trong frontend/vite.config.ts đã chuyển tiếp /api
# sang backend ở cổng 8000. Chỉ đặt giá trị khi frontend và backend chạy ở hai
# địa chỉ khác nhau, ví dụ khi deploy.
