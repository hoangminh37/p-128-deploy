# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Embedding (tầng RAG) ----
# Lấy khoá miễn phí tại https://dashboard.cohere.com/api-keys — không cần thẻ tín dụng.
# Dùng cho embed-multilingual-v3.0, mô hình embedding mặc định của dự án.
COHERE_API_KEY=your-cohere-key-here

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=gsk_your-groq-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ---- Voice (dùng chính OPENAI_API_KEY ở backend, không đưa khoá ra frontend) ----
# Ghi âm được chuyển thành chữ trước khi đi vào LangGraph/RAG hiện có. Âm thanh
# không được lưu trên server; TTS chỉ đọc câu trả lời đã được verifier duyệt.
VOICE_TRANSCRIBE_MODEL=gpt-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy
VOICE_API_TIMEOUT_SECONDS=20

# ---- Video consultation (WebRTC) -------------------------------------------
# JSON array. Không hardcode STUN công cộng; production phải dùng TURN do team
# vận hành để cuộc gọi hoạt động ổn định qua mạng 4G/NAT.
# WEBRTC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"replace-me","credential":"replace-me"}]

# groq | openai | openrouter
#
# OpenRouter là cổng gom nhiều nhà cung cấp sau một API duy nhất theo giao thức
# OpenAI. Chọn nó khi muốn đổi model mà không phải sửa code, hoặc khi một nhà
# cung cấp gỡ model (Groq đã gỡ sạch dòng Llama ngày 24/08/2026).
LLM_PROVIDER=groq
# Model cho provider đang chọn ở LLM_PROVIDER.
#
# Groq       : openai/gpt-oss-120b (mạnh nhất) · openai/gpt-oss-20b · qwen/qwen3.6-27b
#              -> `python scripts/list_groq_models.py` xem key của bạn có gì
# OpenRouter : openai/gpt-oss-120b · deepseek/deepseek-v4-flash · qwen/qwen3-235b-a22b-2507
#              -> `python scripts/list_openrouter_models.py` xem giá thật hôm nay
#
# Mọi node đều dùng with_structured_output, nên model KHÔNG hỗ trợ tool calling
# hay structured output sẽ hỏng toàn bộ agent dù rẻ tới đâu.
MODEL_NAME=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3
# Giới hạn cho intent router/query rewrite; hết thời gian sẽ fail-open, không
# giữ giao diện ở trạng thái đang phân loại vô hạn.
LLM_FAST_TIMEOUT_SECONDS=12
# Generation/verifier thử provider dự phòng khi provider chính lỗi. Mỗi
# provider có giới hạn riêng, còn total là trần cho toàn bộ một node quality.
LLM_QUALITY_TIMEOUT_SECONDS=15
LLM_QUALITY_TOTAL_TIMEOUT_SECONDS=35

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/vectorstore

# ---- Tầng dữ liệu / RAG (src/rag) ----
# Tất cả tham số đều có giá trị mặc định trong src/rag/config.py, chỉ đặt ở đây
# khi muốn thử nghiệm khác đi. Tiền tố bắt buộc là RAG_.
#
# RAG_EMBEDDING_PROVIDER=cohere  # cohere | local | openai. Mặc định cohere.
#                                # ĐỔI GIÁ TRỊ NÀY THÌ PHẢI INDEX LẠI: make rag-index
#                                # (không gian vector khác nhau, không dùng chung được)
# RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-m3   # chỉ dùng khi provider = local
# RAG_CHUNK_MAX_TOKENS=500       # độ dài tối đa một chunk
# RAG_CHUNK_OVERLAP_TOKENS=80    # chồng lấn giữa hai chunk liền nhau
# RAG_TOP_K=6                    # số chunk đưa vào prompt
# RAG_TOP_K_FETCH=24             # số chunk lấy về từ vector store trước khi xếp lại
# RAG_COHERE_TIMEOUT_SECONDS=6   # trần của một request embedding Cohere
# RAG_RETRIEVAL_TIMEOUT_SECONDS=10 # trần toàn bộ bước truy xuất của một câu hỏi
# RAG_RECENCY_WEIGHT=0.15        # điểm cộng cho tài liệu mới hơn (chính sách recency)
# RAG_MIN_SIMILARITY=0.28        # dưới ngưỡng này coi như thư viện không có tài liệu
# RAG_GENERATION_TEMPERATURE=0.0 # 0.0 cho nội dung y tế, không dùng giá trị của LLM_TEMPERATURE
# RAG_RANKING_POLICY=recency     # recency | vn_first, mặc định lấy từ data/registry.yaml

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Cổng ở đây phải khớp với server.port trong frontend/vite.config.ts (đang ghim
# 5180 kèm strictPort). Đổi cổng thì nhớ đổi cả hai chỗ, nếu không trình duyệt
# sẽ chặn request từ frontend vì CORS.
CORS_ORIGINS=http://localhost:5180

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=ai20k_phmNVXYWaPJ-2JI0txxVlg5uClpM3uKl
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# VITE_API_URL=
# Để trống khi chạy dev: proxy trong frontend/vite.config.ts đã chuyển tiếp /api
# sang backend ở cổng 8000. Chỉ đặt giá trị khi frontend và backend chạy ở hai
# địa chỉ khác nhau, ví dụ khi deploy.
