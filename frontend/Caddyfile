:{$PORT:80} {
    root * /srv
    encode gzip

    # Proxy all /api requests to backend
    @api path /api/*
    reverse_proxy @api https://c3-app-128-api.up.railway.app {
        header_up Host c3-app-128-api.up.railway.app
        header_up X-Real-IP {remote_host}
    }

    # SPA routing
    try_files {path} /index.html
    file_server
}
