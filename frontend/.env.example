# Backend thật qua Vite proxy. Không bật MSW khi kiểm thử tư vấn/video.
VITE_ENABLE_MSW=false

# Chỉ bật hai dòng này khi mở ứng dụng từ thiết bị khác cùng mạng LAN.
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_HTTPS_KEY=.local-certs/lan-key.pem
# VITE_DEV_HTTPS_CERT=.local-certs/lan-cert.pem

# Chỉ đổi nếu FastAPI không chạy ở máy/cổng mặc định.
# VITE_DEV_BACKEND_PROXY=http://127.0.0.1:8000
